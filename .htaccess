<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Serve existing files and directories directly (e.g. send_mail.php, images, JS, CSS)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d

  # Route all other requests to index.html so React Router can handle them
  RewriteRule ^ index.html [QSA,L]
</IfModule>
